#!/usr/bin/env python3
"""Standalone fingertip-sensor calibration: {{SIDE}} follower, generated by Teleop Station {{VERSION}} on {{DATE}}.

Needs only `pip install pyserial pyyaml`. Zeroes both pads, then calibrates each pad
against a known weight. Writes per-pad gains the station applies on top of the module's
own scale.

  python {{FILENAME}} [--port {{PORT_RAW}}]
"""

import argparse
import os
import sys
import threading
import time
from datetime import datetime, timezone

import yaml

PORT = {{PORT}}
OUTPUT = {{OUTPUT}}

# ---------------------------------------------------------------- embedded protocol codec
{{CODEC}}
# ---------------------------------------------------------------- end of codec


class FGS:
    def __init__(self, port):
        import serial

        self.ser = serial.Serial(port, 115200, timeout=0.01)
        self.dec, self.seq, self.tel, self.info, self.acks = FrameDecoder(), 0, None, None, {}
        threading.Thread(target=self._rx, daemon=True).start()
        self.send(Ping())
        t = time.time() + 2
        while time.time() < t and (self.info is None or self.tel is None):
            time.sleep(0.02)
        if self.info is None:
            sys.exit(f"no answer from the fingertip sensor on {port}")

    def _rx(self):
        while True:
            for fr in self.dec.feed(self.ser.read(256)):
                p = fr.packet
                if isinstance(p, FingertipTelemetry):
                    self.tel = p
                elif isinstance(p, Info):
                    self.info = p
                elif isinstance(p, Ack):
                    self.acks[p.req_seq] = p

    def send(self, pkt):
        self.seq = (self.seq + 1) & 0xFFFF
        self.ser.write(encode(pkt, self.seq))
        return self.seq

    def average(self, n=200):
        a = b = 0.0
        for _ in range(n):
            a += self.tel.force_a_n
            b += self.tel.force_b_n
            time.sleep(0.003)
        return a / n, b / n


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", default=PORT)
    ap.add_argument("-o", "--output", default=OUTPUT)
    a = ap.parse_args()
    m = FGS(a.port)
    input("1) Open the gripper, nothing touching the pads. Press Enter to zero... ")
    s = m.send(CommandPacket(1))
    time.sleep(0.8)
    print("   residual:", [round(x, 3) for x in m.average()], "N")
    gains = {}
    for pad, idx in (("a", 0), ("b", 1)):
        mass = float(input(f"2{pad}) Mass of the weight for pad {pad.upper()} in grams [1000]: ") or 1000)
        input(f"   Put it on pad {pad.upper()} only and press Enter... ")
        f = m.average(300)[idx]
        true = mass / 1000 * 9.81
        gains[pad] = true / f
        print(f"   measured {f:.2f} N for {true:.2f} N -> gain {gains[pad]:.4f}")
    doc = {"gain_a": round(gains["a"], 5), "gain_b": round(gains["b"], 5),
           "_meta": {"item": "fingertips_{{SIDE}}", "created_at": datetime.now(timezone.utc).isoformat(),
                     "by": "standalone script", "summary": f"gains {gains['a']:.3f} / {gains['b']:.3f}"}}
    os.makedirs(os.path.dirname(os.path.abspath(a.output)), exist_ok=True)
    with open(a.output, "w") as fh:
        yaml.safe_dump(doc, fh, sort_keys=False)
    print(f"Saved {a.output}")


if __name__ == "__main__":
    main()
