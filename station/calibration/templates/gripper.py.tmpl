#!/usr/bin/env python3
"""Standalone follower grip-force calibration: {{SIDE}} YAM ({{CAN_RAW}}), generated by Teleop Station {{VERSION}} on {{DATE}}.

Needs the I2RT SDK (https://github.com/i2rt-robotics/i2rt) and a force gauge or a
luggage scale. Fits F = G * (|tau| - tau0) for the station's haptic feedback.

  python {{FILENAME}}
"""

import os
import time
from datetime import datetime, timezone

import numpy as np
import yaml

CAN_CHANNEL = {{CAN}}
OUTPUT = {{OUTPUT}}
LEVELS_N = [8.0, 18.0, 30.0]
G_NOMINAL = 68.4      # linear_4310: motor_stroke / gripper_stroke
KP, STROKE = 20.0, 6.57


def main():
    from i2rt.robots.get_robot import get_yam_robot

    robot = get_yam_robot(channel=CAN_CHANNEL, zero_gravity_mode=False)
    robot._limit_gripper_force = -1.0  # we command the squeeze directly
    q = robot.get_joint_pos()

    def grip(x):
        cmd = q.copy()
        cmd[6] = float(np.clip(x, 0, 1))
        robot.command_joint_pos(cmd)

    def tau(n=100):
        v = []
        for _ in range(n):
            v.append(float(robot.get_observations()["gripper_eff"][0]))
            time.sleep(0.005)
        return float(np.mean(np.abs(v)))

    input("Clear the gripper fingers and press Enter (measuring friction)... ")
    fr = []
    for x in (0.15, 0.95, 0.15, 0.95):
        grip(x)
        time.sleep(0.15)
        fr.append(tau(40))
        time.sleep(0.6)
    tau_f = float(np.median(fr))
    print(f"friction while moving: {tau_f:.3f} N*m")
    pts = []
    for lvl in LEVELS_N:
        input(f"\nPlace the gauge between the fingers (target {lvl:.0f} N) and press Enter... ")
        grip(0.0)
        time.sleep(1.2)
        x = float(robot.get_observations()["gripper_pos"][0])
        grip(x - lvl / (G_NOMINAL * KP * STROKE))
        time.sleep(0.8)
        t = tau()
        f = float(input(f"  |tau| = {t:.3f} N*m. Gauge reading in N: "))
        pts.append((t, f))
        grip(0.9)
        time.sleep(0.8)
    A = np.array([[t, 1.0] for t, _ in pts])
    y = np.array([f for _, f in pts])
    (g, c), *_ = np.linalg.lstsq(A, y, rcond=None)
    print(f"\nG = {g:.1f} N per N*m, offset {-c / g:.3f} N*m")
    doc = {"gain_n_per_nm": float(g), "tau_offset_nm": float(-c / g), "tau_friction_nm": tau_f,
           "points": [{"tau_abs": t, "measured_n": f} for t, f in pts],
           "_meta": {"item": "gripper_{{SIDE}}", "created_at": datetime.now(timezone.utc).isoformat(),
                     "by": "standalone script", "summary": f"G {g:.1f} N/N*m"}}
    os.makedirs(os.path.dirname(os.path.abspath(OUTPUT)), exist_ok=True)
    with open(OUTPUT, "w") as fh:
        yaml.safe_dump(doc, fh, sort_keys=False)
    print(f"Saved {OUTPUT}")
    robot.close()


if __name__ == "__main__":
    main()
