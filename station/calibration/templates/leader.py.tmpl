#!/usr/bin/env python3
"""Standalone leader-arm calibration: {{SIDE}} arm, generated by Teleop Station {{VERSION}} on {{DATE}}.

Needs only `pip install dynamixel-sdk pyyaml numpy` (plus the i2rt SDK for --match-follower).
Writes a calibration file the station loads directly.

  python {{FILENAME}}                      # known-pose method: zero pose + check pose
  python {{FILENAME}} --match-follower     # pose leader and follower to match, twice (more accurate)
"""

import argparse
import math
import sys
import time
from datetime import datetime, timezone

import numpy as np
import yaml

PORT = {{PORT}}
BAUD = {{BAUD}}
JOINT_IDS = {{JOINT_IDS}}
CHECK_POSE = {{CHECK_POSE}}
CONFIG_SIGNS = {{SIGNS}}
CAN_CHANNEL = {{CAN}}
OUTPUT = {{OUTPUT}}
ADDR_PRESENT_POSITION, ADDR_TORQUE_ENABLE = 132, 64


def wrap(a):
    return (np.asarray(a) + math.pi) % (2 * math.pi) - math.pi


class Bus:
    def __init__(self):
        from dynamixel_sdk import COMM_SUCCESS, GroupSyncRead, PacketHandler, PortHandler

        self.ok = COMM_SUCCESS
        self.port = PortHandler(PORT)
        if not self.port.openPort() or not self.port.setBaudRate(BAUD):
            sys.exit(f"cannot open {PORT} @ {BAUD}: check the U2D2 cable and that you are in the 'dialout' group")
        self.ph = PacketHandler(2.0)
        for i in JOINT_IDS:
            _, res, _ = self.ph.ping(self.port, i)
            if res != self.ok:
                sys.exit(f"servo ID {i} did not answer: check the daisy chain")
            self.ph.write1ByteTxRx(self.port, i, ADDR_TORQUE_ENABLE, 0)
        self.gsr = GroupSyncRead(self.port, self.ph, ADDR_PRESENT_POSITION, 4)
        for i in JOINT_IDS:
            self.gsr.addParam(i)

    def read(self, n=30):
        acc = []
        for _ in range(n):
            if self.gsr.txRxPacket() != self.ok:
                continue
            v = []
            for i in JOINT_IDS:
                x = self.gsr.getData(i, ADDR_PRESENT_POSITION, 4)
                v.append(((x - (1 << 32)) if x & 0x80000000 else x) - 2048)
            acc.append(np.array(v) * 2 * math.pi / 4096)
            time.sleep(0.005)
        a = np.array(acc)
        if a.std(axis=0).max() > 0.01:
            print("  ! the arm moved during the capture: hold still and press Enter again")
            return None
        return a.mean(axis=0)


def follower_reader():
    from i2rt.robots.get_robot import get_yam_robot

    robot = get_yam_robot(channel=CAN_CHANNEL, zero_gravity_mode=True)
    return robot, lambda: np.asarray(robot.get_observations()["joint_pos"], float)[:6]


def capture(bus, prompt, follower=None, known=None):
    while True:
        input(f"\n{prompt}\n  Press Enter to capture... ")
        raw = bus.read()
        if raw is None:
            continue
        q = follower() if follower else np.asarray(known, float)
        print("  leader raw  (deg):", np.round(np.degrees(raw), 1))
        print("  target pose (deg):", np.round(np.degrees(q), 1))
        return raw, q


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--match-follower", action="store_true", help="pose the follower by hand to match (needs i2rt)")
    ap.add_argument("-o", "--output", default=OUTPUT)
    a = ap.parse_args()
    bus = Bus()
    print(f"Leader on {PORT}: {len(JOINT_IDS)} joints OK")
    follower = None
    if a.match_follower:
        robot, follower = follower_reader()
        print("Follower is floating (gravity compensated): you can move it by hand.")
        A = capture(bus, "POSE A: pose BOTH arms identically (any comfortable pose, elbow bent).", follower)
        B = capture(bus, "POSE B: change EVERY joint by at least 20 degrees on both arms, keep them matched.", follower)
    else:
        A = capture(bus, "ZERO POSE: put the leader in the follower's zero pose (all joints 0).", known=[0] * 6)
        B = capture(bus, f"CHECK POSE (deg): {np.round(np.degrees(CHECK_POSE), 0).tolist()}", known=CHECK_POSE)
    dr, dq = wrap(B[0] - A[0]), B[1] - A[1]
    small = [i + 1 for i in range(6) if abs(dq[i]) < math.radians(15)]
    if small:
        sys.exit(f"joints {small} moved less than 15 degrees between poses: run again")
    signs = np.sign(dr * dq)
    offsets = [math.atan2(math.sin(A[0][i] - signs[i] * A[1][i]) + math.sin(B[0][i] - signs[i] * B[1][i]),
                          math.cos(A[0][i] - signs[i] * A[1][i]) + math.cos(B[0][i] - signs[i] * B[1][i])) for i in range(6)]
    res = [max(abs(wrap(signs[i] * (A[0][i] - offsets[i]) - A[1][i])), abs(wrap(signs[i] * (B[0][i] - offsets[i]) - B[1][i])))
           for i in range(6)]
    flipped = [i + 1 for i in range(6) if signs[i] != CONFIG_SIGNS[i]]
    print("\nsigns  :", signs.astype(int).tolist(), f"(flipped vs config: {flipped})" if flipped else "")
    print("offsets:", np.round(offsets, 4).tolist())
    print("residual (deg):", np.round(np.degrees(res), 2).tolist())
    doc = {"offsets": [float(o) for o in offsets], "signs": [int(s) for s in signs],
           "ratio": (np.abs(dr) / np.abs(dq)).round(3).tolist(), "flipped_vs_config": flipped,
           "residual_deg": np.round(np.degrees(res), 2).tolist(),
           "method": "match_follower" if a.match_follower else "known_poses",
           "_meta": {"item": "leader_{{SIDE}}", "created_at": datetime.now(timezone.utc).isoformat(),
                     "by": "standalone script", "summary": f"max residual {math.degrees(max(res)):.1f} deg"}}
    import os
    os.makedirs(os.path.dirname(os.path.abspath(a.output)), exist_ok=True)
    with open(a.output, "w") as f:
        yaml.safe_dump(doc, f, sort_keys=False)
    print(f"\nSaved {a.output}. Restart the arm in the station (Hardware → Reconnect) to load it.")


if __name__ == "__main__":
    main()
