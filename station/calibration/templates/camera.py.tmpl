#!/usr/bin/env python3
"""Standalone camera intrinsics calibration ({{CAMERA}}), generated by Teleop Station {{VERSION}} on {{DATE}}.

Needs `pip install opencv-python pyyaml numpy` (OpenCV >= 4.7). Board: ChArUco 5x7,
DICT_5X5_100. Print it from the station (Calibration → camera → Download board).

  python {{FILENAME}} [--device {{DEVICE_RAW}}] [--square-mm 30 --marker-mm 22]
Press SPACE to capture a view (12+), C to calibrate, Q to quit.
"""

import argparse
import math
import os
from datetime import datetime, timezone

import cv2
import numpy as np
import yaml

DEVICE = {{DEVICE}}
WIDTH, HEIGHT, FPS = {{WIDTH}}, {{HEIGHT}}, {{FPS}}
OUTPUT = {{OUTPUT}}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--device", default=DEVICE)
    ap.add_argument("--square-mm", type=float, default=30.0)
    ap.add_argument("--marker-mm", type=float, default=22.0)
    ap.add_argument("-o", "--output", default=OUTPUT)
    a = ap.parse_args()
    d = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_5X5_100)
    board = cv2.aruco.CharucoBoard((5, 7), a.square_mm / 1000, a.marker_mm / 1000, d)
    det = cv2.aruco.CharucoDetector(board)
    dev = int(a.device) if str(a.device).isdigit() else a.device
    cap = cv2.VideoCapture(dev)
    cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, WIDTH)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, HEIGHT)
    cap.set(cv2.CAP_PROP_FPS, FPS)
    objs, imgs, size = [], [], None
    while True:
        ok, frame = cap.read()
        if not ok:
            print("no frame from camera")
            break
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        size = gray.shape[::-1]
        cc, ci, mc, mi = det.detectBoard(gray)
        view = frame.copy()
        n = 0 if ci is None else len(ci)
        if n:
            cv2.aruco.drawDetectedCornersCharuco(view, cc, ci, (0, 255, 0))
        cv2.putText(view, f"corners {n} | views {len(objs)} | SPACE capture, C calibrate, Q quit", (10, 25),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0) if n >= 8 else (0, 0, 255), 2)
        cv2.imshow("calibration", view)
        k = cv2.waitKey(1) & 0xFF
        if k == ord(" ") and n >= 8:
            o, i = board.matchImagePoints(cc, ci)
            objs.append(o)
            imgs.append(i)
            print(f"captured view {len(objs)} ({n} corners)")
        elif k == ord("c") and len(objs) >= 12:
            break
        elif k == ord("q"):
            return
    rms, K, D, _, _ = cv2.calibrateCamera(objs, imgs, size, None, None)
    print(f"RMS reprojection error: {rms:.3f} px")
    print("K =\n", np.round(K, 2))
    doc = {"camera": "{{CAMERA}}", "rms": float(rms), "image_size": list(size), "camera_matrix": K.tolist(),
           "dist_coeffs": D.reshape(-1).tolist(), "views": len(objs),
           "board": {"squares_x": 5, "squares_y": 7, "square_mm": a.square_mm, "marker_mm": a.marker_mm,
                     "dictionary": "DICT_5X5_100"},
           "_meta": {"item": "camera_{{CAMERA}}", "created_at": datetime.now(timezone.utc).isoformat(),
                     "by": "standalone script", "summary": f"RMS {rms:.3f} px over {len(objs)} views"}}
    os.makedirs(os.path.dirname(os.path.abspath(a.output)), exist_ok=True)
    with open(a.output, "w") as f:
        yaml.safe_dump(doc, f, sort_keys=False)
    print(f"Saved {a.output}")


if __name__ == "__main__":
    main()
