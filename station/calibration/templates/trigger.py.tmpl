#!/usr/bin/env python3
"""Standalone Haptic Grip Module calibration: {{SIDE}} trigger, generated by Teleop Station {{VERSION}} on {{DATE}}.

Needs only `pip install pyserial pyyaml`. The protocol codec is embedded below, so this
file runs on any machine the module is plugged into.

  python {{FILENAME}} [--port {{PORT_RAW}}]
"""

import argparse
import math
import os
import sys
import threading
import time
from datetime import datetime, timezone

import yaml

PORT = {{PORT}}
OUTPUT = {{OUTPUT}}
FINGER_RADIUS = 0.045

# ---------------------------------------------------------------- embedded protocol codec
{{CODEC}}
# ---------------------------------------------------------------- end of codec


class Module:
    def __init__(self, port):
        import serial

        self.ser = serial.Serial(port, 115200, timeout=0.01)
        self.dec = FrameDecoder()
        self.seq = 0
        self.tel = None
        self.acks = {}
        self.info = None
        threading.Thread(target=self._rx, daemon=True).start()
        self.send(Ping())
        t = time.time() + 2
        while time.time() < t and (self.info is None or self.tel is None):
            time.sleep(0.02)
        if self.info is None:
            sys.exit(f"no answer from the module on {port}: is the firmware flashed?")
        print(f"module {self.info.serial} firmware {self.info.fw_version}")

    def _rx(self):
        while True:
            for fr in self.dec.feed(self.ser.read(256)):
                p = fr.packet
                if isinstance(p, Telemetry):
                    self.tel = p
                elif isinstance(p, Ack):
                    self.acks[p.req_seq] = p
                elif isinstance(p, Info):
                    self.info = p
                elif isinstance(p, Log):
                    print(f"  [module] {p.text}")

    def send(self, pkt):
        self.seq = (self.seq + 1) & 0xFFFF
        self.ser.write(encode(pkt, self.seq))
        return self.seq

    def request(self, pkt):
        s = self.send(pkt)
        t = time.time() + 1
        while time.time() < t:
            if s in self.acks:
                a = self.acks.pop(s)
                if a.result != 0:
                    sys.exit(f"module rejected {type(pkt).__name__} (code {a.result})")
                return a.value
            time.sleep(0.005)
        sys.exit(f"no ACK for {type(pkt).__name__}")

    def hold(self, mode, **kw):
        """Stream setpoints (heartbeat) in the background."""
        self._sp = Setpoint(mode=mode, **kw)
        if not getattr(self, "_streaming", False):
            self._streaming = True

            def loop():
                while self._streaming:
                    self.send(self._sp)
                    time.sleep(0.01)
            threading.Thread(target=loop, daemon=True).start()

    def average(self, n=100):
        acc = []
        for _ in range(n):
            t = self.tel
            acc.append((t.lever_rad, t.servo_rad))
            time.sleep(0.004)
        lv = sum(a for a, _ in acc) / n
        sv = sum(b for _, b in acc) / n
        return lv, sv


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", default=PORT)
    ap.add_argument("-o", "--output", default=OUTPUT)
    a = ap.parse_args()
    m = Module(a.port)
    input("\n1) Take your hand OFF the handle, then press Enter (zeroing the force sensor)... ")
    m.hold(Mode.POSITION, pos_cmd=0.5, max_n=12)
    time.sleep(0.8)
    m.request(CommandPacket(Command.TARE_SEA))
    lv, sv = m.average()
    sea_zero = lv - sv
    print(f"   SEA zero = {math.degrees(sea_zero):.2f} deg")
    m.hold(Mode.SPRING, spring_min_n=0.4, spring_n=0.0, max_n=2.0)
    input("2) Leave the trigger fully RELEASED and press Enter... ")
    th_open, _ = m.average()
    input("3) SQUEEZE the trigger all the way, hold it, and press Enter... ")
    th_closed, _ = m.average()
    print(f"   travel = {math.degrees(th_closed - th_open):.1f} deg")
    mass = float(input("4) Mass of your test weight in grams [500]: ") or 500)
    m.hold(Mode.POSITION, pos_cmd=0.5, max_n=12)
    input("   Hang it from the finger-pad hole (trigger at mid-travel) and press Enter... ")
    time.sleep(0.5)
    lv, sv = m.average(200)
    defl = (lv - sv) - sea_zero
    force = mass / 1000 * 9.81
    k = abs(force * FINGER_RADIUS / defl) if abs(defl) > 1e-4 else float("nan")
    print(f"   deflection {math.degrees(defl):.2f} deg  ->  k_theta = {k:.3f} N*m/rad")
    params = {"k_theta": k, "finger_radius": FINGER_RADIUS, "theta_open": th_open, "theta_closed": th_closed,
              "sea_zero": sea_zero}
    for name, v in params.items():
        m.request(SetParam(int(Param[name.upper()]), float(v)))
    m.request(CommandPacket(Command.SAVE_PARAMS))
    m.hold(Mode.SPRING)
    doc = {"backend": "hgm", "params": {k_: round(float(v), 5) for k_, v in params.items()},
           "test": {"mass_g": mass, "force_n": round(force, 3), "deflection_deg": round(math.degrees(defl), 3)},
           "_meta": {"item": "trigger_{{SIDE}}", "created_at": datetime.now(timezone.utc).isoformat(),
                     "by": "standalone script", "summary": f"k {k:.2f} N*m/rad"}}
    os.makedirs(os.path.dirname(os.path.abspath(a.output)), exist_ok=True)
    with open(a.output, "w") as f:
        yaml.safe_dump(doc, f, sort_keys=False)
    print(f"\nSaved {a.output} and stored the parameters in the module's flash.")


if __name__ == "__main__":
    main()
